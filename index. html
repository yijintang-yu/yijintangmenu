<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>易筋堂傳統整復推拿 · 服務菜單</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;700;900&family=Playfair+Display:ital,wght@0,700;1,400&display=swap" rel="stylesheet">
<style>
  :root {
    --crimson: #9B1B1B;
    --cream-bg: #F5EDE0;
    --cream-light: #FBF6EE;
    --cream-dark: #E8D9C5;
    --gold: #8B6914;
    --gold-light: #C9A96E;
    --brown: #5C3D1E;
    --muted: #8a7560;
    --text: #2d1f0e;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background-color: var(--cream-bg);
    color: var(--text);
    font-family: 'Noto Serif TC', serif;
    min-height: 100vh;
    overflow-x: hidden;
    background-image:
      radial-gradient(ellipse 80% 40% at 50% 0%, rgba(139,26,26,0.07) 0%, transparent 60%),
      url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23b89a6a' fill-opacity='0.06'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }

  /* === HEADER === */
  header {
    position: relative;
    text-align: center;
    padding: 52px 20px 36px;
    border-bottom: 2px solid rgba(139,105,20,0.2);
    background: linear-gradient(180deg, rgba(255,250,243,0.9) 0%, transparent 100%);
  }

  header::after {
    content: '';
    position: absolute;
    bottom: -1px; left: 10%; right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-light), transparent);
  }

  .logo-img {
    width: 110px;
    height: 110px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--gold-light);
    box-shadow:
      0 0 0 6px rgba(139,105,20,0.1),
      0 8px 32px rgba(92,61,30,0.25);
    margin: 0 auto 22px;
    display: block;
    animation: float 4s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); box-shadow: 0 0 0 6px rgba(139,105,20,0.1), 0 8px 32px rgba(92,61,30,0.25); }
    50% { transform: translateY(-6px); box-shadow: 0 0 0 6px rgba(139,105,20,0.12), 0 16px 40px rgba(92,61,30,0.3); }
  }

  .brand-en {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 12px;
    letter-spacing: 0.28em;
    color: var(--gold);
    text-transform: uppercase;
    margin-bottom: 6px;
    opacity: 0.75;
  }

  h1 {
    font-size: clamp(26px, 6vw, 40px);
    font-weight: 900;
    letter-spacing: 0.15em;
    color: var(--brown);
    line-height: 1.15;
  }

  h1 .accent { color: var(--crimson); }

  .subtitle {
    margin-top: 10px;
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0.18em;
  }

  /* decorative brush strokes */
  .ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 14px;
    opacity: 0.45;
  }
  .ornament-line {
    height: 1px;
    width: 60px;
    background: linear-gradient(90deg, transparent, var(--gold));
  }
  .ornament-line.r { background: linear-gradient(90deg, var(--gold), transparent); }
  .ornament-diamond {
    width: 6px; height: 6px;
    background: var(--gold-light);
    transform: rotate(45deg);
  }

  /* === TABS === */
  .tabs-wrapper {
    display: flex;
    justify-content: center;
    padding: 34px 20px 0;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tab-btn {
    position: relative;
    background: rgba(255,250,242,0.7);
    border: 1px solid rgba(139,105,20,0.3);
    color: var(--muted);
    font-family: 'Noto Serif TC', serif;
    font-size: 14px;
    letter-spacing: 0.12em;
    padding: 10px 20px;
    cursor: pointer;
    border-radius: 2px;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .tab-btn::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 0; height: 2px;
    background: var(--crimson);
    transition: width 0.35s ease;
  }

  .tab-btn:hover {
    color: var(--brown);
    border-color: var(--gold-light);
    background: rgba(255,250,242,1);
  }

  .tab-btn.active {
    background: #fff;
    border-color: var(--gold-light);
    color: #7A0418;
    font-weight: 700;
    box-shadow: 0 2px 12px rgba(139,26,26,0.1);
  }

  .tab-btn.active::after { width: 100%; }

  /* === CONTENT === */
  .content-area {
    max-width: 700px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }

  .tab-panel { display: none; animation: fadeUp 0.45s ease forwards; }
  .tab-panel.active { display: block; }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* === CARD === */
  .service-card {
    background: linear-gradient(145deg, #fffdf8, #fdf5e8);
    border: 1px solid rgba(139,105,20,0.2);
    border-radius: 6px;
    padding: 40px 36px;
    position: relative;
    overflow: hidden;
    margin-bottom: 28px;
    box-shadow: 0 4px 24px rgba(92,61,30,0.1);
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--crimson), var(--gold-light), var(--crimson), transparent);
  }

  .card-ornament {
    position: absolute;
    top: 16px; right: 22px;
    font-family: 'Noto Serif TC', serif;
    font-size: 72px;
    font-weight: 900;
    color: rgba(139,26,26,0.05);
    line-height: 1;
    pointer-events: none;
  }

  .service-title {
    font-size: clamp(22px, 4vw, 30px);
    font-weight: 900;
    letter-spacing: 0.1em;
    color: var(--brown);
    margin-bottom: 18px;
  }

  .price-row {
    display: flex;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }

  .price-main {
    font-family: 'Playfair Display', serif;
    font-size: 44px;
    font-weight: 700;
    color: var(--crimson);
    line-height: 1;
  }

  .price-main .currency { font-size: 20px; margin-right: 2px; }

  .price-original {
    font-size: 13px;
    color: var(--muted);
    text-decoration: line-through;
    letter-spacing: 0.05em;
  }

  .badge {
    display: inline-block;
    background: rgba(139,26,26,0.08);
    border: 1px solid rgba(139,26,26,0.25);
    color: var(--crimson);
    font-size: 11px;
    letter-spacing: 0.1em;
    padding: 3px 10px;
    border-radius: 2px;
  }

  .service-desc {
    font-size: 14px;
    color: var(--muted);
    line-height: 2;
    letter-spacing: 0.06em;
    margin-bottom: 24px;
  }

  .tag-list { display: flex; flex-wrap: wrap; gap: 8px; }

  .tag {
    font-size: 12px;
    letter-spacing: 0.1em;
    padding: 5px 14px;
    border-radius: 2px;
    border: 1px solid rgba(139,105,20,0.25);
    color: var(--gold);
    background: rgba(139,105,20,0.06);
  }

  /* === DIVIDER === */
  .section-divider {
    text-align: center;
    margin: 44px 0 32px;
    position: relative;
  }

  .section-divider::before {
    content: '';
    position: absolute;
    top: 50%; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(139,105,20,0.3), transparent);
  }

  .section-divider span {
    position: relative;
    background: var(--cream-bg);
    padding: 0 20px;
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-size: 13px;
    color: var(--gold);
    letter-spacing: 0.15em;
  }

  /* === TABLE === */
  .price-table {
    border: 1px solid rgba(139,105,20,0.2);
    border-radius: 4px;
    overflow: hidden;
    background: #fffdf8;
    box-shadow: 0 2px 12px rgba(92,61,30,0.07);
  }

  .price-table-row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    border-bottom: 1px solid rgba(139,105,20,0.1);
  }

  .price-table-row:last-child { border-bottom: none; }

  .price-table-row.header { background: rgba(139,26,26,0.07); }

  .price-table-cell {
    padding: 14px 18px;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--muted);
    border-right: 1px solid rgba(139,105,20,0.1);
  }

  .price-table-cell:last-child { border-right: none; }
  .price-table-row.header .price-table-cell { color: var(--brown); font-size: 12px; letter-spacing: 0.15em; font-weight: 700; }
  .price-table-cell.highlight { color: var(--text); }
  .price-table-cell.price-val { color: var(--crimson); font-weight: 700; }

  /* === FOOTER === */
  footer {
    text-align: center;
    padding: 28px 20px;
    border-top: 1px solid rgba(139,105,20,0.15);
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.14em;
    background: rgba(255,250,242,0.5);
  }

  @media (max-width: 520px) {
    .service-card { padding: 28px 18px; }
    .price-main { font-size: 34px; }
    .price-table-cell { padding: 11px 8px; font-size: 12px; }
  }
</style>
</head>
<body>

<header>
  <img class="logo-img" src="data:image/png;base64,
